<?xml version="1.0" encoding="utf-8"?>
<!-- 麻宝AI · 无障碍服务配置
     为什么 canRetrieveWindowContent=false：本服务只用「按坐标点一下」这一个能力，
       不需要读页面内容（读不到就不存在偷偷记录的可能，被系统/游戏风控盯上的面也最小）。
     为什么 canPerformGestures=true：没有它 dispatchGesture 直接抛异常，点牌全废。
     为什么 eventTypes 只留 typeWindowStateChanged：本服务对事件不做任何事，
       声明最小的那一种，避免每秒被麻将 App 的频繁重绘事件冲爆主线程。 -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/acc_desc"
    android:notificationTimeout="200" />
